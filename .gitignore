# ==========================================
# 1. Dependency Directories
# ==========================================
# Ignores Node modules at the root, frontend, and backend levels
node_modules/
**/node_modules/

# ==========================================
# 2. Environment Variables & Secrets
# ==========================================
# Prevents sensitive API keys and database credentials from leaking
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env*.local

# ==========================================
# 3. Production & Build Artifacts
# ==========================================
# React build output (Vite uses 'dist', Create React App uses 'build')
dist/
build/
**/dist/
**/build/

# Next.js build output (if used for frontend)
.next/
**/.next/

# ==========================================
# 4. Logs and Debugging Files
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# 5. Operating System Clutter
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ==========================================
# 6. IDE / Editor Specific Files
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
